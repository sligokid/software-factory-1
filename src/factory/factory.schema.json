{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://software-factory/factory.schema.json",
  "title": "Factory product contract (.factory/factory.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "runner", "commands"],
  "properties": {
    "version": {"const": 1},
    "runner": {
      "description": "Runner image the agents use for this product.",
      "enum": ["base", "python", "node"]
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verify"],
      "properties": {
        "setup": {"type": "string", "minLength": 1, "description": "Install dependencies."},
        "verify": {"type": "string", "minLength": 1, "description": "Lint, type check and test. Must pass before every commit."},
        "checks": {"type": "string", "minLength": 1, "description": "Optional product-specific rule checks."}
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compose", "service", "port"],
      "properties": {
        "compose": {"type": "string", "minLength": 1},
        "service": {"type": "string", "minLength": 1},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "healthcheck": {"type": "string", "pattern": "^/"},
        "ui": {"type": "boolean", "description": "Reviewer also takes Playwright screenshots."},
        "screenshots": {
          "description": "Paths the reviewer screenshots when ui is true (default: [\"/\"]).",
          "type": "array",
          "items": {"type": "string", "pattern": "^/"},
          "minItems": 1
        }
      }
    },
    "egress": {
      "description": "Extra hosts agents may reach (Anthropic API and GitHub are always allowed).",
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Za-z0-9.-]+$"},
      "uniqueItems": true
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commit_lines": {"type": "integer", "minimum": 1},
        "fixes": {"type": "integer", "minimum": 0, "description": "Fix runs per phase before the feature fails (default 2)."},
        "converge_rounds": {"type": "integer", "minimum": 0, "description": "Converge rounds that may add phases (default 2)."},
        "rework_rounds": {"type": "integer", "minimum": 0, "description": "Rework runs for review feedback (default 2)."},
        "exclude": {"type": "array", "items": {"type": "string"}},
        "files": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 1}
        }
      }
    },
    "protected": {
      "description": "Extra paths agents may not change, added to the factory defaults.",
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
